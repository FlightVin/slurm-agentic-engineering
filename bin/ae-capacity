#!/usr/bin/env bash
# ==========================================================================
# ae-capacity -- MEASURED capacity per partition from your own sacct history:
# GPU-hours received (and the average number of GPUs that implies) over the last
# 72 h and 24 h, median/p90 queue wait (eligible -> start), and preemptions with the
# mean attempt length before one. Feeds the scenario forecasts in agent.md.
# Read-only: one sacct call over ssh, numbers computed locally.
#
# Usage: ae-capacity [window-hours=80]
# ==========================================================================
set -uo pipefail
AE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AE_HOME="${AE_HOME:-$AE_DIR}"
[ -f "$AE_HOME/config.sh" ] || { echo "ae-capacity: no $AE_HOME/config.sh (run ae init)" >&2; exit 2; }
# shellcheck disable=SC1091
. "$AE_HOME/config.sh"
H="${1:-80}"
ssh -n -o BatchMode=yes -o ConnectTimeout=20 "$AE_HOST" \
    "sacct -u \$USER -D -X -P -n -S now-${H}hours -o JobID,JobName,Partition,State,Submit,Eligible,Start,End,AllocTRES" \
| python3 -c '
import sys, re, statistics as st
from datetime import datetime, timedelta
parts = [p for p in sys.argv[1:] if p]
now = datetime.now().replace(microsecond=0)
P = lambda s: None if s in ("Unknown", "None", "") else datetime.fromisoformat(s)
rows = [l.rstrip("\n").split("|") for l in sys.stdin if l.count("|") == 8]
def gpus(t):
    m = re.search(r"gres/gpu=(\d+)", t); return int(m.group(1)) if m else 0
for part in parts:
    att = [(r[0], r[1], r[3], P(r[4]), P(r[5]), P(r[6]), P(r[7]) or now, gpus(r[8])) for r in rows if r[2] == part]
    att = [a for a in att if a[7] > 0 and a[5]]
    for hrs in (72, 24):
        w0 = now - timedelta(hours=hrs)
        gh = sum(a[7] * max(0, (min(a[6], now) - max(a[5], w0)).total_seconds()) for a in att) / 3600
        print(f"{part:10} last {hrs:2} h: {gh:7.1f} GPU-h received = {gh/hrs:5.2f} GPUs average")
    waits = sorted((a[5] - (a[4] or a[3])).total_seconds() / 3600 for a in att if a[5] >= now - timedelta(hours=72) and (a[4] or a[3]))
    if waits:
        print(f"{part:10} attempts started in 72 h: {len(waits)}; median wait {st.median(waits):.2f} h; p90 {waits[max(0, int(.9*len(waits))-1)]:.2f} h")
    pre = [a for a in att if a[2] == "PREEMPTED" and a[6] >= now - timedelta(hours=72)]
    mean = st.mean([(a[6]-a[5]).total_seconds()/3600 for a in pre]) if pre else 0
    print(f"{part:10} preemptions in 72 h: {len(pre)}; mean attempt length before preemption {mean:.2f} h")
' "$AE_PARTITION" "${AE_PARTITION_GEN:-}"
