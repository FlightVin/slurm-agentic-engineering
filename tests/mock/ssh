#!/usr/bin/env bash
# MOCK ssh for tests: runs the "remote" command locally with HOME=$MOCK_REMOTE_HOME.
nostdin=0; cmd=(); host=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) nostdin=1; shift;;
    -o|-p|-i|-l) shift 2;;
    -O) exit 0;;                          # ControlMaster check/exit: always "ok"
    -t|-T|-q|-v) shift;;
    *) if [ -z "$host" ]; then host="$1"; shift; else cmd=("$@"); break; fi;;
  esac
done
[ ${#cmd[@]} -eq 0 ] && exit 0
if [ $nostdin = 1 ]; then HOME="$MOCK_REMOTE_HOME" bash -c "${cmd[*]}" < /dev/null
else HOME="$MOCK_REMOTE_HOME" bash -c "${cmd[*]}"; fi
